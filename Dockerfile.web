# --- Builder: produce the static SPA bundle ---
FROM node:20-bookworm-slim AS builder

WORKDIR /app

COPY package*.json ./
RUN npm install

COPY . .
RUN npm run build

# --- Runner: serve the static files with nginx ---
FROM nginx:1.27-alpine AS runner

# Landing (/) + SPA (/app) routing + /api proxy config
COPY nginx.conf /etc/nginx/conf.d/default.conf

# Marketing landing page at the site root, SPA under /app.
COPY --from=builder /app/landing /usr/share/nginx/html
COPY --from=builder /app/dist /usr/share/nginx/html/app

EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
