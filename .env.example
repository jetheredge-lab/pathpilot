# ── RoundsAhead deployment configuration ────────────────────────────
# Copy to `.env` on the host and fill in. `.env` is git-ignored.

# ── Database ────────────────────────────────────────────────────────
# Password for the bundled Postgres container (and the api's DATABASE_URL).
POSTGRES_PASSWORD=""

# ── Auth ────────────────────────────────────────────────────────────
# Secret used to sign session JWTs. Generate a long random value, e.g.:
#   openssl rand -base64 48
JWT_SECRET=""

# Set to "true" once the app is served exclusively over HTTPS (roundsahead.com)
# so session cookies are marked Secure. Leave false for LAN/http testing.
COOKIE_SECURE="false"

# ── Cloudflare Tunnel (only for the `cloudflare` compose profile) ────
CLOUDFLARE_TUNNEL_TOKEN=""
