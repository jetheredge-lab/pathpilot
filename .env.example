# ── RoundsAhead deployment configuration ────────────────────────────
# Copy to `.env` on the host and fill in. `.env` is git-ignored.

# ── Database ────────────────────────────────────────────────────────
# Password for the bundled Postgres container (and the api's DATABASE_URL).
POSTGRES_PASSWORD=""

# ── Auth ────────────────────────────────────────────────────────────
# Secret used to sign session JWTs. Generate a long random value, e.g.:
#   openssl rand -base64 48
JWT_SECRET=""

# Set to "true" once the app is served exclusively over HTTPS (roundsahead.com)
# so session cookies are marked Secure. Leave false for LAN/http testing.
COOKIE_SECURE="false"

# ── OAuth (social sign-in) ──────────────────────────────────────────
# Public base URL (no trailing slash). Used to build OAuth redirect URIs.
APP_BASE_URL="https://roundsahead.com"

# Google OAuth 2.0 Web client (Google Cloud Console > Credentials).
# Authorized redirect URI: https://roundsahead.com/api/auth/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Sign in with Apple. Team ID + a Services ID (the web client_id) + a Key ID,
# and the .p8 key placed at ./secrets/apple_key.p8 on the host.
# Return URL to register: https://roundsahead.com/api/auth/apple/callback
APPLE_TEAM_ID=""
APPLE_SERVICES_ID=""
APPLE_KEY_ID=""

# ── Payments (Stripe) ───────────────────────────────────────────────
# Start with TEST keys (sk_test_...). Create a one-time Price and put its id in
# STRIPE_PRICE_ID. Add a webhook endpoint pointing at
#   https://roundsahead.com/api/billing/webhook
# and put its signing secret (whsec_...) in STRIPE_WEBHOOK_SECRET.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_ID=""
# Months of access granted by one license purchase (one-time payment model).
ENTITLEMENT_MONTHS="12"

# ── Cloudflare Tunnel (only for the `cloudflare` compose profile) ────
CLOUDFLARE_TUNNEL_TOKEN=""
