# ── PathPilot deployment configuration ──────────────────────────────
# Copy to `.env` on the host and fill in. `.env` is git-ignored.

# Cloudflare Tunnel token (from: Zero Trust > Networks > Tunnels > your tunnel).
# Required only when running with the `cloudflare` compose profile.
CLOUDFLARE_TUNNEL_TOKEN=""

# ── Cloudflare Access identity (backend auth) ───────────────────────
# Your Zero Trust team domain, without https:// (e.g. myteam.cloudflareaccess.com).
CF_ACCESS_TEAM_DOMAIN=""

# The Access application's Audience (AUD) tag.
# From: Zero Trust > Access > Applications > (your app) > Overview > Application Audience (AUD) Tag.
CF_ACCESS_AUD=""

# If BOTH values above are left blank, the API runs in local-dev mode and
# treats every request as a single fixed user (dev@local) with no auth.
